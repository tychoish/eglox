;;; test-eglox-defaults.el --- Settings lifecycle tests -*- lexical-binding: t; -*-
;;; Commentary:
;; Check configuration overrides and restoration.
;;; Code:
(require 'ert)
(require 'eglox)
(defvar eglox-test-setting 'original)
(ert-deftest eglox-settings-override-and-restore ()
  (let ((eglox-test-setting 'original)
        (eglox-setting-overrides '((eglox-test-setting . nil)))
        (eglox--saved-settings nil))
    (eglox--apply-settings)
    (should-not eglox-test-setting)
    (eglox--restore-settings)
    (should (eq eglox-test-setting 'original))
    (eglox--apply-settings)
    (setq eglox-test-setting 'changed)
    (eglox--restore-settings)
    (should (eq eglox-test-setting 'changed))))
(ert-deftest eglox-global-mode-rolls-back-on-error ()
  "A failed activation releases the project integration it acquired."
  (let ((eglox-global-mode nil)
        (eglox--global-active nil)
        (eglox--owns-project-mode nil)
        (eglox-project-mode nil))
    (cl-letf (((symbol-function 'eglox-project-mode)
               (lambda (arg) (setq eglox-project-mode (> arg 0))))
              ((symbol-function 'eglox--apply-settings)
               (lambda (&rest _) (error "test failure"))))
      (should-error (eglox-global-mode 1))
      (should-not eglox-global-mode)
      (should-not eglox--global-active)
      (should-not eglox-project-mode)
      (should-not eglox--owns-project-mode))))
(ert-deftest eglox-settings-refresh-and-late-definition ()
  "Repeated refresh preserves independent changes and late definitions."
  (let ((eglox-global-mode t)
        (show-paren-delay show-paren-delay)
        (eglox--saved-settings nil)
        (eglox--relinquished-settings nil)
        (eglox-setting-overrides '((eglox-test-late . chosen)))
        (load-history (copy-tree load-history)))
    (unwind-protect
        (progn
          (makunbound 'eglox-test-late)
          (eglox--apply-settings)
          (push '("test-late.el" eglox-test-late) load-history)
          (eglox--restore-settings)
          (should (eq (default-value 'eglox-test-late) 'chosen))
          (setq eglox-setting-overrides nil)
          (eglox--apply-settings)
          (setq-default show-paren-delay 0.73)
          (eglox-refresh-settings)
          (eglox-refresh-settings)
          (should (= (default-value 'show-paren-delay) 0.73)))
      (eglox--restore-settings)
      (makunbound 'eglox-test-late))))
(ert-deftest eglox-local-settings-restore-and-preserve-changes ()
  (let ((eglox--configured-buffers nil))
    (with-temp-buffer
      (setq-local fill-column 75)
      (kill-local-variable 'tab-width)
      (let ((original-tab (default-value 'tab-width)))
        (eglox--python-setup)
        (should (= fill-column eglox-python-fill-column))
        (should (= tab-width eglox-python-tab-width))
        (eglox--python-setup)
        (setq-local fill-column 91)
        (eglox--python-setup)
        (should (= fill-column 91))
        (eglox--restore-local-buffers)
        (should (= fill-column 91))
        (should-not (local-variable-p 'tab-width))
        (should (= tab-width original-tab))))))

(ert-deftest eglox-local-settings-restore-prior-local-value ()
  (let ((eglox--configured-buffers nil))
    (with-temp-buffer
      (setq-local fill-column 73)
      (eglox--python-setup)
      (eglox--restore-local-buffers)
      (should (local-variable-p 'fill-column))
      (should (= fill-column 73)))))

(defvar yaml-pro-mode)

(ert-deftest eglox-local-mode-ownership ()
  (let ((eglox--configured-buffers nil)
        (eglox-enable-yaml-pro t)
        (yaml-pro-mode nil))
    (cl-letf (((symbol-function 'yaml-pro-mode)
               (lambda (arg) (setq-local yaml-pro-mode (> arg 0)))))
      (with-temp-buffer
        (eglox--yaml-setup)
        (should yaml-pro-mode)
        (eglox--yaml-setup)
        (eglox--restore-local-buffers)
        (should-not yaml-pro-mode))
      (with-temp-buffer
        (setq-local yaml-pro-mode t)
        (eglox--yaml-setup)
        (eglox--restore-local-buffers)
        (should yaml-pro-mode)))))

(ert-deftest eglox-local-settings-ignore-killed-buffers ()
  (let ((eglox--configured-buffers nil)
        (buffer (generate-new-buffer " *eglox-killed*")))
    (with-current-buffer buffer (eglox--python-setup))
    (kill-buffer buffer)
    (eglox--restore-local-buffers)
    (should-not eglox--configured-buffers)))

(ert-deftest eglox-settings-overlapping-owners-out-of-order ()
  "Two modes setting the same symbol to the same or different values restore in any order."
  (let ((eglox-test-setting 'original)
        (eglox--saved-settings nil)
        (eglox--relinquished-settings nil)
        (eglox-project--saved-settings nil)
        (eglox-project--relinquished-settings nil)
        (eglox-global-mode t)
        (eglox-project--active t)
        (eglox-setting-overrides '((eglox-test-setting . shared)))
        (eglox-project-setting-overrides '((eglox-test-setting . shared))))
    (unwind-protect
        (progn
          ;; Same value, out-of-order disable (first mode disables while second stays active)
          (eglox--apply-settings)
          (eglox-project--apply-settings)
          (should (eq (default-value 'eglox-test-setting) 'shared))
          (eglox--restore-settings)
          (should (eq (default-value 'eglox-test-setting) 'shared))
          (eglox-project--restore-settings)
          (should (eq (default-value 'eglox-test-setting) 'original))
          ;; Refresh lower mode while upper mode is active
          (eglox--apply-settings)
          (setq eglox-project-setting-overrides '((eglox-test-setting . upper)))
          (eglox-project--apply-settings)
          (setq eglox-setting-overrides '((eglox-test-setting . lower-updated)))
          (eglox-refresh-settings)
          (should (eq (default-value 'eglox-test-setting) 'upper))
          (eglox-project--restore-settings)
          (should (eq (default-value 'eglox-test-setting) 'lower-updated))
          (eglox--restore-settings)
          (should (eq (default-value 'eglox-test-setting) 'original)))
      (eglox-project--restore-settings)
      (eglox--restore-settings)
      (put 'eglox-test-setting :setting-owners nil))))

(provide 'test-eglox-defaults)
;;; test-eglox-defaults.el ends here

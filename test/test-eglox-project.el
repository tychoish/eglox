(ert-deftest eglox-project/refresh-explicit-override-reclaims-setting ()
  (let ((eglox-project--active t)
        (eglox-project--saved-settings nil)
        (eglox-project--relinquished-settings nil)
        (eglox-project--settings '((eglox-project-test-value . applied)))
        (eglox-project-setting-overrides nil))
    (unwind-protect
        (progn

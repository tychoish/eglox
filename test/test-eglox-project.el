;;; test-eglox-project.el --- Tests for project integration -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'eglox-project)

(ert-deftest eglox-project/cache-is-central-and-unique ()
  (let ((eglox-project-cache-directory (make-temp-file "eglox-cache-" t)))
    (unwind-protect
        (let ((one (eglox-project--cache-file nil "/tmp/one/project/"))
              (two (eglox-project--cache-file nil "/tmp/two/project/"))
              (remote (eglox-project--cache-file nil "/ssh:host:/tmp/project/")))
          (should (string-prefix-p eglox-project-cache-directory one))
          (should-not (equal one two))
          (should-not (equal one remote))
          (should (equal one (eglox-project--cache-file nil "/tmp/one/project"))))
      (delete-directory eglox-project-cache-directory t))))

(ert-deftest eglox-project/settings-apply-and-restore ()
  (let ((eglox-project--saved-settings nil)
        (eglox-project-settings '((eglox-project-test-value . nil)
                                  (eglox-project-test-bound . updated))))
    (unwind-protect
        (progn
          (makunbound 'eglox-project-test-value)
          (set-default 'eglox-project-test-bound 'before)
          (eglox-project--apply-settings)
          (should (boundp 'eglox-project-test-value))
          (should-not (default-value 'eglox-project-test-value))
          (should (eq (default-value 'eglox-project-test-bound) 'updated))
          (eglox-project--restore-settings)
          (should-not (boundp 'eglox-project-test-value))
          (should (eq (default-value 'eglox-project-test-bound) 'before)))
      (eglox-project--restore-settings)
      (makunbound 'eglox-project-test-value)
      (makunbound 'eglox-project-test-bound))))

(ert-deftest eglox-project/mode-preserves-existing-projectile ()
  (require 'projectile)
  (let ((eglox-project-mode nil)
        (eglox-project--active nil)
        (eglox-project--owns-projectile nil)
        (eglox-project--saved-settings nil)
        (eglox-project-mode-hooks nil)
        (projectile-mode t)
        calls)
    (cl-letf (((symbol-function 'projectile-mode)
               (lambda (arg) (push arg calls) (setq projectile-mode (> arg 0)))))
      (unwind-protect
          (progn
            (eglox-project-mode 1)
            (eglox-project-mode 1)
            (eglox-project-mode -1)
            (eglox-project-mode -1)
            (should projectile-mode)
            (should-not calls))
        (eglox-project-mode -1)))))

(ert-deftest eglox-project/mode-acquires-projectile-once ()
  (require 'projectile)
  (let ((eglox-project-mode nil)
        (eglox-project--active nil)
        (eglox-project--owns-projectile nil)
        (eglox-project--saved-settings nil)
        (eglox-project-mode-hooks nil)
        (projectile-mode nil)
        calls)
    (cl-letf (((symbol-function 'projectile-mode)
               (lambda (arg) (push arg calls) (setq projectile-mode (> arg 0)))))
      (unwind-protect
          (progn
            (eglox-project-mode 1)
            (eglox-project-mode 1)
            (eglox-project-mode -1)
            (eglox-project-mode -1)
            (should-not projectile-mode)
            (should (equal calls '(-1 1))))
        (eglox-project-mode -1)))))

(ert-deftest eglox-project/cache-persists-without-touching-legacy-file ()
  (require 'projectile)
  (let* ((base (make-temp-file "eglox-project-test-" t))
         (root (expand-file-name "project/" base))
         (eglox-project-cache-directory (expand-file-name "cache/" base))
         (projectile-enable-caching 'persistent)
         (projectile-projects-cache (make-hash-table :test #'equal))
         (files '("a.el" "dir/b.el"))
         (legacy (expand-file-name ".projectile-cache.eld" root)))
    (unwind-protect
        (progn
          (make-directory root)
          (with-temp-file legacy (insert "legacy user data"))
          (set-file-modes root #o500)
          (cl-letf (((symbol-function 'projectile-project-cache-file)
                     (lambda (&optional project-root)
                       (eglox-project--cache-file nil project-root))))
            (let ((cache-file (projectile-project-cache-file root)))
              (projectile-cache-project root files)
              (should (file-exists-p cache-file))
              (should (equal (projectile-load-project-cache root) files))
              (should (string-prefix-p eglox-project-cache-directory cache-file))
              (should (= (logand (file-modes eglox-project-cache-directory) #o777) #o700))
              (should (equal (with-temp-buffer
                               (insert-file-contents legacy)
                               (buffer-string))
                             "legacy user data")))))
      (when (file-directory-p root) (set-file-modes root #o700))
      (delete-directory base t))))

(provide 'test-eglox-project)
